{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./*"
            ]
        },
        "allowJs": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noImplicitAny": true
    },
    "include": [
        "scripts/**/*",
        "lib/**/*",
        "models/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}